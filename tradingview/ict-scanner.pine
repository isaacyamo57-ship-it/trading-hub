//@version=5
indicator("iFVG Ultimate+ | ICT Scanner (NQ)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// --- INPUTS ---
fvg_show    = input.bool(true,  "Show FVG Boxes")
ifvg_show   = input.bool(true,  "Show IFVG / Inversion Level")
eql_show    = input.bool(true,  "Show Equal Highs/Lows")
kz_show     = input.bool(true,  "Show Killzone Shading")
sess_show   = input.bool(true,  "Show Session Open Lines")
dh_show     = input.bool(true,  "Show Data Highs/Lows")

// --- COLOURS ---
bull_box    = color.new(#00c980, 80)
bull_border = color.new(#00c980, 40)
bear_box    = color.new(#ff4d4d, 80)
bear_border = color.new(#ff4d4d, 40)
ifvg_col    = color.new(#3b82f6, 0)
kz_col      = color.new(#3b82f6, 93)
eql_col     = color.new(#facc15, 60)
sess_col    = color.new(#94a3b8, 70)
dh_col      = color.new(#e2e8f0, 50)

// --- KILLZONE SHADING (NYAM 8:30-11:00 NY) ---
is_nyam = not na(time("1", "0830-1100", "America/New_York"))
bgcolor(kz_show and is_nyam ? kz_col : na, title="NYAM Killzone")

// --- SESSION OPEN LINES ---
t_800  = not na(time("1", "0800-0801", "America/New_York"))
t_830  = not na(time("1", "0830-0831", "America/New_York"))
t_930  = not na(time("1", "0930-0931", "America/New_York"))

if sess_show and t_800
    line.new(bar_index, low,  bar_index + 60, low,  color=sess_col, style=line.style_dotted, width=1)
    label.new(bar_index + 62, low, "8:00 AM", color=color.new(color.black, 100), textcolor=sess_col, style=label.style_none, size=size.tiny)

if sess_show and t_830
    line.new(bar_index, low,  bar_index + 60, low,  color=sess_col, style=line.style_dotted, width=1)
    label.new(bar_index + 62, low, "8:30 AM", color=color.new(color.black, 100), textcolor=sess_col, style=label.style_none, size=size.tiny)

if sess_show and t_930
    line.new(bar_index, low,  bar_index + 60, low,  color=sess_col, style=line.style_dotted, width=1)
    label.new(bar_index + 62, low, "9:30 AM", color=color.new(color.black, 100), textcolor=sess_col, style=label.style_none, size=size.tiny)

// --- FAIR VALUE GAPS ---
bull_fvg = low > high[2]
bear_fvg = high < low[2]

var box[]   bull_boxes   = array.new_box()
var float[] bull_tops    = array.new_float()
var float[] bull_bots    = array.new_float()
var int[]   bull_bi      = array.new_int()

var box[]   bear_boxes   = array.new_box()
var float[] bear_tops    = array.new_float()
var float[] bear_bots    = array.new_float()
var int[]   bear_bi      = array.new_int()

if bull_fvg and fvg_show
    b = box.new(bar_index[2], low, bar_index + 40, high[2], border_color=bull_border, bgcolor=bull_box, text="FVG", text_color=bull_border, text_size=size.tiny, text_halign=text.align_right)
    array.push(bull_boxes, b)
    array.push(bull_tops, low)
    array.push(bull_bots, high[2])
    array.push(bull_bi, bar_index)

if bear_fvg and fvg_show
    b = box.new(bar_index[2], high, bar_index + 40, low[2], border_color=bear_border, bgcolor=bear_box, text="FVG", text_color=bear_border, text_size=size.tiny, text_halign=text.align_right)
    array.push(bear_boxes, b)
    array.push(bear_tops, low[2])
    array.push(bear_bots, high)
    array.push(bear_bi, bar_index)

// Extend boxes to current bar and remove when mitigated
if array.size(bull_boxes) > 0
    for i = array.size(bull_boxes) - 1 to 0
        b   = array.get(bull_boxes, i)
        top = array.get(bull_tops, i)
        bot = array.get(bull_bots, i)
        box.set_right(b, bar_index + 20)
        if close < bot
            box.delete(b)
            array.remove(bull_boxes, i)
            array.remove(bull_tops, i)
            array.remove(bull_bots, i)
            array.remove(bull_bi, i)

if array.size(bear_boxes) > 0
    for i = array.size(bear_boxes) - 1 to 0
        b   = array.get(bear_boxes, i)
        top = array.get(bear_tops, i)
        bot = array.get(bear_bots, i)
        box.set_right(b, bar_index + 20)
        if close > top
            box.delete(b)
            array.remove(bear_boxes, i)
            array.remove(bear_tops, i)
            array.remove(bear_bots, i)
            array.remove(bear_bi, i)

// --- IFVG / INVERSION DETECTION ---
var bool  ifvg_bull_active = false
var bool  ifvg_bear_active = false
var float ifvg_bull_level  = na
var float ifvg_bear_level  = na
var line  dd_plus_line      = na

if array.size(bear_tops) > 0
    for i = 0 to array.size(bear_tops) - 1
        t = array.get(bear_tops, i)
        b = array.get(bear_bots, i)
        if close >= b and close <= t
            ifvg_bull_active := true
            ifvg_bull_level  := b
            break

if array.size(bull_tops) > 0
    for i = 0 to array.size(bull_tops) - 1
        t = array.get(bull_tops, i)
        b = array.get(bull_bots, i)
        if close >= b and close <= t
            ifvg_bear_active := true
            ifvg_bear_level  := t
            break

// Draw DD+ inversion entry line
if ifvg_show and ifvg_bull_active and not na(ifvg_bull_level)
    if not na(dd_plus_line)
        line.delete(dd_plus_line)
    dd_plus_line := line.new(bar_index - 5, ifvg_bull_level, bar_index + 30, ifvg_bull_level, color=ifvg_col, style=line.style_solid, width=2)
    label.new(bar_index + 32, ifvg_bull_level, "DD+", color=color.new(color.black, 100), textcolor=ifvg_col, style=label.style_none, size=size.small)

if ifvg_show and ifvg_bear_active and not na(ifvg_bear_level)
    if not na(dd_plus_line)
        line.delete(dd_plus_line)
    dd_plus_line := line.new(bar_index - 5, ifvg_bear_level, bar_index + 30, ifvg_bear_level, color=ifvg_col, style=line.style_solid, width=2)
    label.new(bar_index + 32, ifvg_bear_level, "DD+", color=color.new(color.black, 100), textcolor=ifvg_col, style=label.style_none, size=size.small)

// --- MSS DETECTION ---
lookback       = 10
swing_high     = ta.highest(high, lookback)[1]
swing_low      = ta.lowest(low,   lookback)[1]
mss_bull_close = close > swing_high and close[1] <= swing_high[1]
mss_bear_close = close < swing_low  and close[1] >= swing_low[1]

plotshape(mss_bull_close, "MSS Bull", shape.triangleup,   location.belowbar, color.new(#00c980, 0), size=size.tiny)
plotshape(mss_bear_close, "MSS Bear", shape.triangledown, location.abovebar, color.new(#ff4d4d, 0), size=size.tiny)

// --- EQUAL HIGHS / EQUAL LOWS ---
eql_thr = syminfo.mintick * 10
eqh = math.abs(high - high[1]) <= eql_thr
eql = math.abs(low  - low[1])  <= eql_thr

if eql_show and eqh
    line.new(bar_index[1], high[1], bar_index + 10, high, color=eql_col, style=line.style_dotted, width=1)
if eql_show and eql
    line.new(bar_index[1], low[1],  bar_index + 10, low,  color=eql_col, style=line.style_dotted, width=1)

// --- DATA HIGHS / LOWS (significant wicks beyond structure) ---
var float data_high = na
var float data_low  = na

wick_up   = high - math.max(open, close)
wick_down = math.min(open, close) - low
avg_range = ta.atr(14)

if dh_show and wick_up > avg_range * 0.7
    data_high := high
    line.new(bar_index, high, bar_index + 50, high, color=dh_col, style=line.style_dashed, width=1)
    label.new(bar_index + 52, high, "Data Highs", color=color.new(color.black, 100), textcolor=dh_col, style=label.style_none, size=size.tiny)

if dh_show and wick_down > avg_range * 0.7
    data_low := low
    line.new(bar_index, low, bar_index + 50, low, color=dh_col, style=line.style_dashed, width=1)
    label.new(bar_index + 52, low, "Data Lows", color=color.new(color.black, 100), textcolor=dh_col, style=label.style_none, size=size.tiny)

// --- HTF BIAS ---
[htf_4h_close, htf_4h_high, htf_4h_low] = request.security(syminfo.tickerid, "240", [close, high, low])
[htf_1h_close, htf_1h_high, htf_1h_low] = request.security(syminfo.tickerid, "60",  [close, high, low])

bias_4h_bull  = htf_4h_close > ta.highest(htf_4h_high, 10)[1]
bias_4h_bear  = htf_4h_close < ta.lowest(htf_4h_low,   10)[1]
bias_1h_bull  = htf_1h_close > ta.highest(htf_1h_high, 10)[1]
bias_1h_bear  = htf_1h_close < ta.lowest(htf_1h_low,   10)[1]
bias_15m_bull = close > ta.highest(high, 10)[1]
bias_15m_bear = close < ta.lowest(low,   10)[1]

all_bullish = bias_4h_bull and bias_1h_bull and bias_15m_bull
all_bearish = bias_4h_bear and bias_1h_bear and bias_15m_bear

// --- CANDLE DATA FOR DODGYDD SCORING ---
candle_range       = high - low
candle_body        = math.abs(close - open)
body_pct           = candle_range > 0 ? candle_body / candle_range : 0
wick_ratio         = candle_range > 0 ? (candle_range - candle_body) / candle_range : 0
close_vs_edge_bull = ifvg_bull_level > 0 ? (close - ifvg_bull_level) / (high - ifvg_bull_level + syminfo.mintick) : 0
close_vs_edge_bear = ifvg_bear_level > 0 ? (ifvg_bear_level - close) / (ifvg_bear_level - low + syminfo.mintick) : 0

// --- SEQUENCE CHECK ---
long_setup  = is_nyam and all_bullish and ifvg_bull_active and mss_bull_close
short_setup = is_nyam and all_bearish and ifvg_bear_active and mss_bear_close

// --- STRATEGY CHECKLIST TABLE ---
show_checklist = input.bool(true, "Show Strategy Checklist", group="CHECKLIST")
show_grade     = input.bool(true, "Show Setup Grade",        group="CHECKLIST")

if barstate.islast and show_checklist
    tbl = table.new(position.top_right, 2, 9, bgcolor=color.new(#0f172a, 10), border_color=color.new(#334155, 80), border_width=1, frame_color=color.new(#334155, 60), frame_width=1)

    // Header
    table.cell(tbl, 0, 0, "ICT SETUP CHECKLIST", text_color=#94a3b8, text_size=size.tiny, bgcolor=color.new(#1e293b, 20), text_halign=text.align_left)
    table.cell(tbl, 1, 0, "", bgcolor=color.new(#1e293b, 20))

    // Bias alignment
    bias_ok = all_bullish or all_bearish
    bias_dir = all_bullish ? "BULL" : all_bearish ? "BEAR" : "MIXED"
    table.cell(tbl, 0, 1, "HTF Bias (4H/1H/15M)", text_color=#cbd5e1, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 1, bias_ok ? "✓ " + bias_dir : "✗ " + bias_dir, text_color=bias_ok ? #00c980 : #ff4d4d, text_size=size.tiny, bgcolor=color.new(bias_ok ? #00c980 : #ff4d4d, 92))

    // Killzone
    table.cell(tbl, 0, 2, "NYAM Killzone", text_color=#cbd5e1, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 2, is_nyam ? "✓ ACTIVE" : "✗ CLOSED", text_color=is_nyam ? #00c980 : #ff4d4d, text_size=size.tiny, bgcolor=color.new(is_nyam ? #00c980 : #ff4d4d, 92))

    // FVG present
    fvg_present = array.size(bull_boxes) > 0 or array.size(bear_boxes) > 0
    table.cell(tbl, 0, 3, "FVG Present", text_color=#cbd5e1, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 3, fvg_present ? "✓ YES" : "✗ NONE", text_color=fvg_present ? #00c980 : #ff4d4d, text_size=size.tiny, bgcolor=color.new(fvg_present ? #00c980 : #ff4d4d, 92))

    // IFVG / Inversion
    ifvg_ok = ifvg_bull_active or ifvg_bear_active
    table.cell(tbl, 0, 4, "IFVG Inverting", text_color=#cbd5e1, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 4, ifvg_ok ? "✓ YES" : "✗ NO", text_color=ifvg_ok ? #00c980 : #ff4d4d, text_size=size.tiny, bgcolor=color.new(ifvg_ok ? #00c980 : #ff4d4d, 92))

    // MSS
    mss_ok = mss_bull_close or mss_bear_close
    table.cell(tbl, 0, 5, "MSS Confirmed", text_color=#cbd5e1, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 5, mss_ok ? "✓ YES" : "✗ NO", text_color=mss_ok ? #00c980 : #ff4d4d, text_size=size.tiny, bgcolor=color.new(mss_ok ? #00c980 : #ff4d4d, 92))

    // Dodgydd body strength
    body_grade = body_pct >= 0.85 ? "4/4" : body_pct >= 0.70 ? "3/4" : body_pct >= 0.50 ? "2/4" : body_pct >= 0.30 ? "1/4" : "0/4"
    body_ok = body_pct >= 0.70
    table.cell(tbl, 0, 6, "Candle Strength", text_color=#cbd5e1, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 6, body_grade, text_color=body_ok ? #00c980 : #facc15, text_size=size.tiny, bgcolor=color.new(body_ok ? #00c980 : #facc15, 92))

    // Grade
    if show_grade
        setup_complete = bias_ok and is_nyam and ifvg_ok and mss_ok
        grade_str = long_setup or short_setup ? "A+" : setup_complete ? "A" : bias_ok and ifvg_ok ? "B+" : "—"
        grade_col = (long_setup or short_setup) ? #facc15 : setup_complete ? #00c980 : bias_ok and ifvg_ok ? #3b82f6 : #64748b
        table.cell(tbl, 0, 7, "SETUP GRADE", text_color=#94a3b8, text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(#1e293b, 20))
        table.cell(tbl, 1, 7, grade_str, text_color=grade_col, text_size=size.small, bgcolor=color.new(grade_col, 85))

    // Direction
    dir_str = long_setup ? "LONG" : short_setup ? "SHORT" : bias_ok ? (all_bullish ? "BULL BIAS" : "BEAR BIAS") : "WAIT"
    dir_col = (long_setup or all_bullish) ? #00c980 : (short_setup or all_bearish) ? #ff4d4d : #64748b
    table.cell(tbl, 0, 8, "DIRECTION", text_color=#94a3b8, text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(#1e293b, 20))
    table.cell(tbl, 1, 8, dir_str, text_color=dir_col, text_size=size.tiny, bgcolor=color.new(dir_col, 85))

// --- ALERT PAYLOADS ---
long_msg  = '{"direction":"long","killzone":"nyam","killzone_active":true,"ny_time":"' + str.tostring(hour(time, "America/New_York")) + ':' + str.tostring(minute(time, "America/New_York")) + '","htf_bias":"bullish","timeframes_aligned":["4H","1H","15M"],"sweep_type":"sellside","fvg_zone":[' + str.tostring(math.round(ifvg_bull_level, 2)) + ',' + str.tostring(math.round(close, 2)) + '],"mss_confirmed":true,"cisd_confirmed":false,"candle_body_pct":' + str.tostring(math.round(body_pct, 3)) + ',"candle_wick_ratio":' + str.tostring(math.round(wick_ratio, 3)) + ',"candles_to_invert":1,"close_vs_ifvg_edge":' + str.tostring(math.round(close_vs_edge_bull, 3)) + ',"nearest_targets":["EQL_above"],"stop_level":' + str.tostring(math.round(low, 2)) + ',"timestamp":"{{timenow}}"}'
short_msg = '{"direction":"short","killzone":"nyam","killzone_active":true,"ny_time":"' + str.tostring(hour(time, "America/New_York")) + ':' + str.tostring(minute(time, "America/New_York")) + '","htf_bias":"bearish","timeframes_aligned":["4H","1H","15M"],"sweep_type":"buyside","fvg_zone":[' + str.tostring(math.round(close, 2)) + ',' + str.tostring(math.round(ifvg_bear_level, 2)) + '],"mss_confirmed":true,"cisd_confirmed":false,"candle_body_pct":' + str.tostring(math.round(body_pct, 3)) + ',"candle_wick_ratio":' + str.tostring(math.round(wick_ratio, 3)) + ',"candles_to_invert":1,"close_vs_ifvg_edge":' + str.tostring(math.round(close_vs_edge_bear, 3)) + ',"nearest_targets":["EQH_above"],"stop_level":' + str.tostring(math.round(high, 2)) + ',"timestamp":"{{timenow}}"}'

if long_setup
    alert(long_msg, alert.freq_once_per_bar_close)
    label.new(bar_index, low - (syminfo.mintick * 30), "A+ LONG", color=color.new(#00c980, 10), textcolor=color.white, style=label.style_label_up, size=size.small)

if short_setup
    alert(short_msg, alert.freq_once_per_bar_close)
    label.new(bar_index, high + (syminfo.mintick * 30), "A+ SHORT", color=color.new(#ff4d4d, 10), textcolor=color.white, style=label.style_label_down, size=size.small)
